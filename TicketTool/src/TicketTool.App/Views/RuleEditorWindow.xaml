<Window x:Class="TicketTool.App.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="字段" Style="{StaticResource SectionTitle}"/>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Fields}"
                         SelectedItem="{Binding SelectedField}"
                         DisplayMemberPath="FieldName"
                         BorderThickness="0"
                         Background="Transparent"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding RawTextHint}"
                           Style="{StaticResource Muted}"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedField.FieldName, StringFormat=字段：{0}}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="识别顺序：优先级高的规则先执行；格式校验通过的结果优先采用。"
                                   Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="新增规则" Command="{Binding AddRuleCommand}" Style="{StaticResource BaseButton}"/>
                        <Button Content="删除选中规则" Command="{Binding RemoveRuleCommand}" Style="{StaticResource DangerButton}" Margin="0"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1"
                          Height="190"
                          Margin="0,10,0,10"
                          ItemsSource="{Binding Rules}"
                          SelectedItem="{Binding SelectedRule}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="120"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="规则类型" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1"
                                              Width="220"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding RuleTypeOptions}"
                                              SelectedValue="{Binding SelectedRule.RuleType}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Text"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="优先级" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Width="60" Text="{Binding SelectedRule.Priority, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                                        <CheckBox Content="启用" IsChecked="{Binding SelectedRule.Enabled}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding SelectedRule.IsAnchor, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                    <TextBlock Text="名称（用顿号、逗号或换行分隔）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedRule.AliasesText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="56"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="值格式（可留空；填写后只采纳符合格式的内容）" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding SelectedRule.ValuePattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：[A-Za-z0-9-]{6,32}"/>
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding SelectedRule.IsPreset, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                    <TextBlock Text="预置类型" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox Width="280"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding PresetOptions}"
                                              SelectedValue="{Binding SelectedRule.PresetKey}"
                                              SelectedValuePath="Key"
                                              DisplayMemberPath="DisplayName"/>
                                    <TextBlock Text="补充名称（可留空）" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding SelectedRule.AliasesText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="44"/>
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding SelectedRule.IsRegex, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                    <TextBlock Text="高级匹配表达式" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedRule.RegexPattern, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas, Microsoft YaHei UI"
                                             MinHeight="48"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"/>
                                    <TextBlock Text="取值分组名（可留空，默认取整体匹配）" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding SelectedRule.RegexGroup, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding SelectedRule.IsSegment, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                    <TextBlock Text="名称（用顿号、逗号或换行分隔）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedRule.AliasesText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="44"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="分隔符" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Width="90" Text="{Binding SelectedRule.Separator, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="16,0,0,0">
                                            <TextBlock Text="取第几段（从 0 开始）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Width="80" Text="{Binding SelectedRule.SegmentIndex, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="试跑" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <Button Content="试跑当前字段" Command="{Binding TrialCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Margin="0,6,0,0">
                                    <Run Text="当前取值："/>
                                    <Run Text="{Binding TrialValue}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </TextBlock>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding TrialMessage}" Style="{StaticResource Muted}" Margin="0,6,0,6"/>
                                    <DataGrid Height="130" ItemsSource="{Binding Candidates}" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="符合格式" Binding="{Binding IsValid}" IsReadOnly="True" Width="80"/>
                                            <DataGridTextColumn Header="规则" Binding="{Binding Description}" Width="150"/>
                                            <DataGridTextColumn Header="取值" Binding="{Binding Value}" Width="*"/>
                                            <DataGridTextColumn Header="起点" Binding="{Binding StartOffset}" Width="60"/>
                                            <DataGridTextColumn Header="终点" Binding="{Binding EndOffset}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="保存后会自动生成新版本，可随时回退。" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="保存规则" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
                        <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource BaseButton}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
