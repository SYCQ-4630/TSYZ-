<Window x:Class="TicketTool.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="通信工单助手"
        Width="1360"
        Height="880"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="通信工单助手" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="粘贴工单，自动识别，一键归档" Style="{StaticResource Muted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="目标模板" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Width="230"
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              DisplayMemberPath="Name"
                              ToolTip="{Binding TemplateHint}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="新建模板" Command="{Binding NewTemplateCommand}" Style="{StaticResource BaseButton}"/>
                    <Button Content="编辑模板" Command="{Binding EditTemplateCommand}" Style="{StaticResource BaseButton}"/>
                    <Button Content="删除模板" Command="{Binding DeleteTemplateCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="{Binding SyncBadge.Text}"
                        ToolTip="{Binding SyncBadge.Detail}"
                        Command="{Binding ShowSyncDetailsCommand}"
                        Style="{StaticResource Badge}"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="4"
                        Content="创建示例"
                        Command="{Binding CreateSampleCommand}"
                        Style="{StaticResource BaseButton}"
                        VerticalAlignment="Center"
                        Margin="0"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <TabItem Header="工单录入">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="工单原文" Style="{StaticResource SectionTitle}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding RawLengthText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="粘贴" Command="{Binding PasteCommand}" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="从文件导入" Command="{Binding ImportCsvCommand}" Style="{StaticResource BaseButton}" Margin="0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <ProgressBar Height="6"
                                             Maximum="100"
                                             Value="{Binding ParseProgressValue}"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Visibility="{Binding IsParsing, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding ParseProgressText}"
                                           Style="{StaticResource Muted}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding IsParsing, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>

                            <TextBox Grid.Row="2"
                                     Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalContentAlignment="Top"
                                     FontFamily="Microsoft YaHei UI, Consolas"
                                     FontSize="13"
                                     Padding="10"/>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Text="粘贴后会自动按当前模板识别；可先核对再导入。"
                                           Style="{StaticResource Muted}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="重新识别" Command="{Binding ParseCommand}" Style="{StaticResource BaseButton}"/>
                                    <Button Content="编辑规则" Command="{Binding EditRulesCommand}" Style="{StaticResource BaseButton}" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="识别预览" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock Text="{Binding TemplateHint}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ParsedCountText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontWeight="SemiBold"/>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <Border Background="#FFF4E5" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="6" Padding="10"
                                        Visibility="{Binding IsTemplateFileMissing, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="目标表格已被移动或删除。请先编辑模板并重新选择文件，再导入。"
                                               Foreground="{StaticResource WarningBrush}"/>
                                </Border>
                                <Border Background="#FDECEA" BorderBrush="#F5B5AE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0"
                                        Visibility="{Binding HasMissingFields, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="以下字段未识别，可在表格中手动补充后再导入：" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                        <ItemsControl ItemsSource="{Binding MissingFields}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White" BorderBrush="#F5B5AE" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding}" FontSize="12"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding PreviewFields}"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      SelectionUnit="Cell">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" IsReadOnly="True" Width="110"/>
                                    <DataGridTextColumn Header="识别值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" IsReadOnly="True" Width="82"/>
                                    <DataGridTextColumn Header="提示" Binding="{Binding Note}" IsReadOnly="True" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="3" Margin="0,12,0,0" Padding="10" Background="#F7F9FC" CornerRadius="6">
                                <Grid>
                                    <TextBlock Text="规则版本" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ComboBox Width="180"
                                                  ItemsSource="{Binding RuleVersions}"
                                                  SelectedItem="{Binding SelectedRuleVersion}"
                                                  Margin="0,0,8,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="回退到该版本" Command="{Binding RollbackRulesCommand}" Style="{StaticResource BaseButton}" Margin="0,0,8,0"/>
                                        <Button Content="复制其他模板规则" Command="{Binding CopyRulesCommand}" Style="{StaticResource BaseButton}" Margin="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="4"
                                       Text="{Binding StatusMessage}"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <Grid Grid.Row="5" Margin="0,10,0,0">
                                <Button Content="打开表格所在目录"
                                        Command="{Binding OpenTemplateFolderCommand}"
                                        Style="{StaticResource BaseButton}"
                                        HorizontalAlignment="Left"/>
                                <Button Content="确认导入"
                                        Command="{Binding ConfirmImportCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        MinWidth="130"
                                        Margin="0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="查询与导出">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="34"
                                     ToolTip="输入工单号、手机号、固定电话或投诉地址"/>
                            <ComboBox Grid.Column="1"
                                      Width="120"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding SearchDomainOptions}"
                                      SelectedItem="{Binding SelectedSearchDomain}"
                                      DisplayMemberPath="Text"/>
                            <CheckBox Grid.Column="2"
                                      Content="仅当前模板"
                                      IsChecked="{Binding SearchCurrentTemplateOnly}"
                                      VerticalAlignment="Center"
                                      Margin="12,0"/>
                            <Button Grid.Column="3" Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Grid.Column="4" Content="查看原文" Command="{Binding OpenTraceCommand}" Style="{StaticResource BaseButton}" Margin="0"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,8">
                        <TextBlock Text="{Binding SearchSummary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource BaseButton}"/>
                            <Button Content="导出 TSV" Command="{Binding ExportTsvCommand}" Style="{StaticResource BaseButton}" Margin="0"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SearchResults}"
                              SelectedItem="{Binding SelectedSearchResult}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="模板" Binding="{Binding TemplateName}" Width="150"/>
                            <DataGridTextColumn Header="命中字段" Binding="{Binding FieldName}" Width="120"/>
                            <DataGridTextColumn Header="命中内容" Binding="{Binding DisplayValue}" Width="*"/>
                            <DataGridTextColumn Header="入库时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="上一页" Command="{Binding PreviousPageCommand}" Style="{StaticResource BaseButton}"/>
                            <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource BaseButton}" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="诊断与备份">
                <Grid Margin="0,12,0,0" DataContext="{Binding Diagnostics}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Summary}" />
                            <TextBlock Text="{Binding IntegrityText}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="完整性检查" Command="{Binding QuickCheckCommand}" Style="{StaticResource BaseButton}"/>
                                <Button Content="立即备份" Command="{Binding BackupNowCommand}" Style="{StaticResource BaseButton}"/>
                                <Button Content="导出诊断包" Command="{Binding ExportBundleCommand}" Style="{StaticResource BaseButton}"/>
                                <Button Content="打开日志目录" Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource BaseButton}" Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="日志筛选" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <ComboBox Width="130" ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding LevelFilter}" Margin="0,0,8,0"/>
                            <TextBox Width="150" Text="{Binding ModuleFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="模块或事件名"/>
                            <TextBox Width="220" Text="{Binding KeywordFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="关键词"/>
                            <Button Content="应用筛选" Command="{Binding RefreshCommand}" Style="{StaticResource BaseButton}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding LogsDirectory}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Logs}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="120"/>
                            <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="90"/>
                            <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="160"/>
                            <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="4" Margin="0,10,0,6">
                        <TextBlock Text="未完成的同步任务" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="重试选中项" Command="{Binding RetrySelectedCommand}" Style="{StaticResource BaseButton}" HorizontalAlignment="Right"/>
                    </Grid>

                    <DataGrid Grid.Row="5" ItemsSource="{Binding SyncItems}" SelectedItem="{Binding SelectedSyncItem}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="工单编号" Binding="{Binding TicketId}" Width="100"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status, Converter={StaticResource SyncStatusText}}" Width="110"/>
                            <DataGridTextColumn Header="重试数" Binding="{Binding Retry}" Width="70"/>
                            <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="140"/>
                            <DataGridTextColumn Header="最近错误" Binding="{Binding LastError}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="6" Text="{Binding DatabasePath}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="4,10,4,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="处理中…" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="数据保存位置"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
