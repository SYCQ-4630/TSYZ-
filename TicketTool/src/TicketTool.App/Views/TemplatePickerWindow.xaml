<Window x:Class="TicketTool.App.Views.TemplatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择来源模板"
        Width="460"
        Height="440"
        MinWidth="400"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="从其他模板复制同名字段的规则：" FontWeight="SemiBold"/>
        <ListBox x:Name="TemplateList"
                 Grid.Row="1"
                 Margin="0,10,0,12"
                 DisplayMemberPath="Name"/>

        <Grid Grid.Row="2">
            <TextBlock Text="只复制名称与列完全一致的字段。" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制" Click="OnConfirmClick" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
                <Button Content="取消" Click="OnCancelClick" Style="{StaticResource BaseButton}" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
