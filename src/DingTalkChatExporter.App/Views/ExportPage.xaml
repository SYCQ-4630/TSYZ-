<UserControl x:Class="DingTalkChatExporter.App.Views.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="导出与预览" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="按模板列标题填充字段；模板文件永不被修改。"
                           Style="{StaticResource PageDescriptionStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <TextBlock Text="{Binding RowSummary}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,6,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出设置" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SourceSummary}"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />

                        <TextBlock Text="Excel 模板" Style="{StaticResource LabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TemplatePath}" IsReadOnly="True" ToolTip="{Binding TemplatePath}" />
                            <Button Grid.Column="1" Content="选择…" Command="{Binding PickTemplateCommand}" Margin="6,0,0,0" />
                        </Grid>

                        <TextBlock Text="输出文件" Style="{StaticResource LabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputPath}" IsReadOnly="True" ToolTip="{Binding OutputPath}" />
                            <Button Grid.Column="1" Content="另存为…" Command="{Binding PickOutputCommand}" Margin="6,0,0,0" />
                        </Grid>

                        <TextBlock Text="工作表（留空自动匹配）" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding SheetName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="留空时自动选择包含最多匹配列标题的工作表" />

                        <TextBlock Text="写入模式" Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{Binding Modes}"
                                  SelectedItem="{Binding SelectedMode}"
                                  DisplayMemberPath="Name" />

                        <TextBlock Text="规则库" Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{Binding RuleLibraries}"
                                  SelectedItem="{Binding SelectedLibrary}"
                                  DisplayMemberPath="Name" />

                        <StackPanel Margin="0,14,0,0">
                            <CheckBox Content="输出文件已存在时先备份"
                                      IsChecked="{Binding BackupExisting}" />
                            <CheckBox Content="低置信度单元格高亮"
                                      IsChecked="{Binding HighlightLowConfidence}"
                                      Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="预检写入位置" Command="{Binding PreflightCommand}" Margin="0,0,8,0" />
                            <Button Content="开始导出" Command="{Binding ExportCommand}" />
                        </StackPanel>

                        <Button Content="刷新快照预览"
                                Command="{Binding RefreshSnapshotCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0" />

                        <Border Margin="0,16,0,0"
                                Background="{StaticResource PageBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="预检结果" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PreflightText}"
                                           Margin="0,6,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,12,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />

                        <Button Content="打开导出文件夹"
                                Command="{Binding UseLastResultFolderCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding PreviewRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeaderWidth="0"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding LocalTime}" Width="140" />
                        <DataGridTextColumn Header="发送人" Binding="{Binding SenderName}" Width="100" />
                        <DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*" />
                        <DataGridTextColumn Header="字段" Binding="{Binding FieldsText}" Width="200" />
                        <DataGridTextColumn Header="提示" Binding="{Binding ConfidenceHint}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
