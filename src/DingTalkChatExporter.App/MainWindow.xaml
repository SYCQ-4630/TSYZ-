<Window x:Class="DingTalkChatExporter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DingTalkChatExporter.App.Views"
        xmlns:vm="clr-namespace:DingTalkChatExporter.App.ViewModels"
        Title="钉钉聊天记录导出工具"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCurrentCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="M" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="R" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="T" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="E" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="H" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="S" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SnapshotPageViewModel}">
            <views:SnapshotPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesPageViewModel}">
            <views:RulesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TablesPageViewModel}">
            <views:TablesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportPageViewModel}">
            <views:ExportPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryPageViewModel}">
            <views:HistoryPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <views:SettingsPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource SidebarBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="22,24,22,18">
                        <TextBlock Text="钉钉聊天记录导出"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="只读导出工具"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Navigation}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItemViewModel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding SelectedPage}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DataDirectory}"
                           Margin="12,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="420"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           ToolTip="{Binding DataDirectory}" />
                <TextBlock Text="F5 刷新 · Ctrl+1~6 切换页面"
                           Grid.Column="2"
                           Margin="12,0,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="3"
                           Text="{Binding VersionText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
