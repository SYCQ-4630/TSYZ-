<UserControl x:Class="DingTalkChatExporter.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DingTalkChatExporter.App.ViewModels"
             Background="{StaticResource PageBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="导入与导出历史" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="清空记录只影响列表，不会删除磁盘上的 Excel、索引或导出文件。"
                           Style="{StaticResource PageDescriptionStyle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="刷新"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Bottom" />
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="14,9">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>

        <TabControl Grid.Row="2" Margin="0,12,0,0">
            <TabItem Header="导入记录">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Imports}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource CardBorderBrush}"
                              RowHeaderWidth="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="导入时间" Binding="{Binding ImportedAt}" Width="150" />
                            <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="180" />
                            <DataGridTextColumn Header="文件路径" Binding="{Binding FilePath}" Width="*" />
                            <DataGridTextColumn Header="绑定规则库" Binding="{Binding RuleLibraryName}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1"
                            Content="清空导入记录"
                            Command="{Binding ClearImportsCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="回收站">
                <Grid Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding Removed}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource CardBorderBrush}"
                              RowHeaderWidth="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="移除时间" Binding="{Binding RemovedAt}" Width="150" />
                            <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="160" />
                            <DataGridTextColumn Header="文件状态" Binding="{Binding Availability}" Width="130" />
                            <DataGridTextColumn Header="文件路径" Binding="{Binding FilePath}" Width="*" />
                            <DataGridTemplateColumn Header="" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:RemovedTableRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="恢复"
                                                    Padding="10,2"
                                                    Margin="0,0,6,0"
                                                    IsEnabled="{Binding FileExists}"
                                                    Command="{Binding DataContext.RestoreRemovedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="打开文件"
                                                    Padding="10,2"
                                                    Margin="0,0,6,0"
                                                    IsEnabled="{Binding FileExists}"
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="移除记录"
                                                    Padding="10,2"
                                                    Command="{Binding DataContext.DismissRemovedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="导出统计">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Exports}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource CardBorderBrush}"
                              RowHeaderWidth="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="导出时间" Binding="{Binding ExportedAt}" Width="150" />
                            <DataGridTextColumn Header="群聊 / 来源" Binding="{Binding SourceName}" Width="160" />
                            <DataGridTextColumn Header="输出文件" Binding="{Binding OutputPath}" Width="*" />
                            <DataGridTextColumn Header="行数" Binding="{Binding ExportedCount}" Width="70" />
                            <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="90" />
                            <DataGridTextColumn Header="低置信度" Binding="{Binding LowConfidenceCount}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1"
                            Content="清空导出统计"
                            Command="{Binding ClearExportsCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
