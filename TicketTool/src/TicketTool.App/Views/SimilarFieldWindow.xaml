<Window x:Class="TicketTool.App.Views.SimilarFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认相似字段"
        Width="820"
        Height="620"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="原文中有几个字段的名称与模板字段相近" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="请确认每个值应写入哪一列。选择只影响本次预览，模板规则不会改变。"
                       Style="{StaticResource Muted}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,14,0,14"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding SourceDisplay}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OccurrenceText}"
                                           Style="{StaticResource Muted}"
                                           Margin="0,4,0,8"/>
                                <ComboBox ItemsSource="{Binding Candidates}"
                                          SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <TextBlock Text="不确定时选择“忽略”，原始规则结果保持不变。"
                       Style="{StaticResource Muted}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="全部忽略" Click="OnIgnoreAllClick" Style="{StaticResource BaseButton}"/>
                <Button Content="确定" Click="OnConfirmClick" Style="{StaticResource PrimaryButton}"/>
                <Button Content="取消" Click="OnCancelClick" Style="{StaticResource BaseButton}" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
