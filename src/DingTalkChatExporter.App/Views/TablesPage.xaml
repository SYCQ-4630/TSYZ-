<UserControl x:Class="DingTalkChatExporter.App.Views.TablesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DingTalkChatExporter.App.ViewModels"
             Background="{StaticResource PageBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="表格管理" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="导入的表格只读使用；搜索索引保存在本地 indexes 目录。"
                           Style="{StaticResource PageDescriptionStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="导入表格" Command="{Binding ImportTableCommand}" Margin="0,0,8,0" />
                <Button Content="刷新列表" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ProgressBar Grid.Column="1"
                             IsIndeterminate="True"
                             Width="120"
                             Height="3"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,12,0">
                <ListBox ItemsSource="{Binding Tables}"
                         SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TableCellViewModel}">
                            <StackPanel Margin="2,5" ToolTip="{Binding FilePath}">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="10"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding IndexedAtText}"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20,16">
                <Grid IsEnabled="{Binding HasSelection}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="显示名称" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,10,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="重命名" Command="{Binding RenameCommand}" Margin="0,0,6,0" />
                            <Button Content="设为当前" Command="{Binding SetActiveCommand}" Margin="0,0,6,0" />
                            <Button Content="从列表移除" Command="{Binding RemoveCommand}" Margin="0,0,6,0" />
                            <Button Content="物理删除…" Command="{Binding DeletePhysicallyCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="绑定规则库" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RuleLibraries}"
                                  SelectedItem="{Binding BoundLibrary}"
                                  DisplayMemberPath="Name" />
                        <Button Grid.Column="2" Content="应用绑定" Command="{Binding ApplyBindingCommand}" Margin="8,0,0,0" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding SelectedTable.FilePath}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   ToolTip="{Binding SelectedTable.FilePath}" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="全文索引" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedTable.IndexStatusText}"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium" />
                        <Button Grid.Column="2"
                                Content="建立 / 重建索引"
                                Command="{Binding BuildIndexCommand}"
                                Margin="12,0,0,0" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding SelectedTable.IndexedAtText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="在索引中搜索单元格文本" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Columns}"
                                  SelectedItem="{Binding SearchColumn}"
                                  Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="搜索" Command="{Binding SearchIndexCommand}" Margin="8,0,0,0" />
                        <Button Grid.Column="3" Content="清空" Command="{Binding ClearSearchCommand}" Margin="6,0,0,0" />
                    </Grid>

                    <DataGrid Grid.Row="4"
                              ItemsSource="{Binding SearchResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource CardBorderBrush}"
                              RowHeaderWidth="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行号" Binding="{Binding RowIndex}" Width="80" />
                            <DataGridTextColumn Header="列" Binding="{Binding ColumnName}" Width="150" />
                            <DataGridTextColumn Header="匹配内容" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
