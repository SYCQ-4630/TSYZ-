<UserControl x:Class="DingTalkChatExporter.App.Views.SnapshotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DingTalkChatExporter.App.ViewModels"
             Background="{StaticResource PageBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="会话与快照" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="只读抓取群聊消息，先去重再套用规则，快照保存在本地。"
                           Style="{StaticResource PageDescriptionStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <TextBlock Text="{Binding CountSummary}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CardStyle}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="群标识" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding GroupIdentifier, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="可直接粘贴 dws 群标识，不必先搜索" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="开始日期" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker SelectedDate="{Binding StartDate}" Width="130" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="结束日期" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker SelectedDate="{Binding EndDate}" Width="130" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="最多条数" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding MaxResults, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="检查数据源" Command="{Binding RefreshStatusCommand}" Margin="0,0,8,0" />
                    <Button Content="抓取快照" Command="{Binding FetchCommand}" Margin="0,0,8,0" />
                    <Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Content="清空预览" Command="{Binding ClearPreviewCommand}" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="增量读取"
                                  IsChecked="{Binding UseIncremental}"
                                  ToolTip="勾选后从该群上次抓取水位继续读取，并合并已有预览；首次抓取仍使用左侧日期范围"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0" />
                        <TextBlock Text="规则库"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding RuleLibraries}"
                                  SelectedItem="{Binding SelectedLibrary}"
                                  DisplayMemberPath="Name"
                                  Width="200" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource CardStyle}" Padding="12,10"
                Visibility="{Binding HasGroupResults, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="搜索结果（点击“使用”填入群标识）"
                           FontSize="11"
                           Margin="2,0,0,6"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ListBox ItemsSource="{Binding GroupResults}" MaxHeight="150" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GroupLookupItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="使用"
                                        Padding="12,2"
                                        Command="{Binding DataContext.UseGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="数据源状态" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SourceSummary}"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding DwsStatusText}"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding FlaUiStatusText}"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding StrategyText, StringFormat=路由策略：{0}}"
                                   Margin="0,4,0,10"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />

                        <Separator Margin="0,4,0,12" />

                        <TextBlock Text="群搜索" FontSize="13" FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding GroupQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="输入群名称后搜索；失败时可手动填写群标识" />
                            <Button Grid.Column="1"
                                    Content="搜索"
                                    Margin="6,0,0,0"
                                    Command="{Binding SearchGroupsCommand}" />
                        </Grid>

                        <TextBlock Text="最近使用"
                                   Margin="0,16,0,6"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding RecentGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left"
                                            Margin="0,2"
                                            Padding="8,6"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.UseRecentGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                            <TextBlock Text="{Binding Identifier}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Messages}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeaderWidth="0"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding LocalTime}" Width="140" />
                        <DataGridTextColumn Header="发送人" Binding="{Binding SenderName}" Width="110" />
                        <DataGridTextColumn Header="类型" Binding="{Binding MessageType}" Width="80" />
                        <DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*" />
                        <DataGridTextColumn Header="提取字段" Binding="{Binding FieldsText}" Width="190" />
                        <DataGridTextColumn Header="提示" Binding="{Binding ConfidenceHint}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
